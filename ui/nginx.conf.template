server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA: qualquer rota desconhecida devolve o index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy para a API .NET. O browser so fala com esta origem,
    # entao nao existe CORS envolvido.
    location /api/ {
        # Resolver do Docker + upstream em variavel: o nginx passa a resolver o
        # nome no momento do request, e nao na subida. Sem isso ele morre com
        # "host not found in upstream" se a API ainda nao existir.
        resolver           127.0.0.11 ipv6=off valid=10s;
        set $upstream      ${API_UPSTREAM};
        proxy_pass         http://$upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # Ingest sobe PDF grande e pode levar minutos.
        client_max_body_size 100m;
        proxy_read_timeout   1800s;
        proxy_send_timeout   1800s;
    }
}
