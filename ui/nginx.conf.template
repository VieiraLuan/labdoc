server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA: any unknown route falls back to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy to the .NET API. The browser only ever talks to this origin,
    # so CORS never comes into play.
    location /api/ {
        # Docker's resolver plus the upstream in a variable: nginx resolves the
        # name at request time instead of at startup. Without this it dies with
        # "host not found in upstream" when the API is not up yet.
        resolver           127.0.0.11 ipv6=off valid=10s;
        set $upstream      ${API_UPSTREAM};
        proxy_pass         http://$upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # Ingest uploads large PDFs, and extraction can run for minutes.
        client_max_body_size 100m;
        proxy_read_timeout   1800s;
        proxy_send_timeout   1800s;
    }
}
